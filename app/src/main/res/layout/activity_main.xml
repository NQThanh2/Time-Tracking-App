<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app_blur">

    <ImageView android:id="@+id/backgroundImageView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:contentDescription="@null" android:importantForAccessibility="no"
        android:scaleType="centerCrop" android:visibility="gone" />
    <View android:id="@+id/backgroundScrim"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/bg_photo_scrim"
        android:importantForAccessibility="no" android:visibility="gone" />

    <androidx.core.widget.NestedScrollView android:id="@+id/main"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="32dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="22dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/workspace_eyebrow" android:letterSpacing="0.16"
                        android:textAppearance="@style/TextAppearance.Attendance.Label" />
                    <TextView android:id="@+id/appTitleText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/dashboard_title"
                        android:fontFamily="sans-serif-medium" android:textSize="30sp"
                        android:letterSpacing="-0.035" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/todayDateText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.Attendance.Label" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/backgroundButton"
                    style="@style/Widget.Attendance.IconButton"
                    android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="12dp"
                    android:contentDescription="@string/background_image" app:icon="@drawable/ic_photo" />
            </LinearLayout>

            <com.example.myapplication.GlassCardView android:id="@+id/todayCard"
                style="@style/Widget.Attendance.GlassCard"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/today_section" android:textAppearance="@style/TextAppearance.Attendance.Title" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:background="@drawable/bg_month_total" android:paddingHorizontal="10dp" android:paddingVertical="5dp"
                            android:text="@string/offline_badge" android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="11sp" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="22dp" android:layout_marginBottom="20dp"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/today_total_label" android:textAppearance="@style/TextAppearance.Attendance.Label" />
                            <TextView android:id="@+id/totalTodayValueText"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:textSize="36sp" android:fontFamily="sans-serif-medium"
                                android:letterSpacing="-0.04" android:textColor="?attr/colorPrimary" />
                        </LinearLayout>
                        <ImageView android:layout_width="64dp" android:layout_height="64dp"
                            android:layout_marginStart="10dp" android:padding="15dp"
                            android:background="@drawable/bg_month_total"
                            android:src="@drawable/ic_fingerprint" app:tint="?attr/colorPrimary"
                            android:contentDescription="@null" android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/bg_summary_row" android:padding="16dp" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/check_in_label" android:textAppearance="@style/TextAppearance.Attendance.Label" />
                            <TextView android:id="@+id/checkInValueText"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                                android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="44dp"
                            android:layout_gravity="center_vertical" android:layout_marginHorizontal="16dp"
                            android:background="?attr/colorOutlineVariant" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/check_out_label" android:textAppearance="@style/TextAppearance.Attendance.Label" />
                            <TextView android:id="@+id/checkOutValueText"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                                android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:orientation="horizontal" android:clipChildren="false">
                        <com.google.android.material.button.MaterialButton android:id="@+id/checkInButton"
                            style="@style/Widget.Attendance.PrimaryButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginEnd="6dp" android:text="@string/scan_in" app:icon="@drawable/ic_login" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/checkOutButton"
                            style="@style/Widget.Attendance.GlassButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="6dp" android:text="@string/scan_out" app:icon="@drawable/ic_logout" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/catchUpButton"
                        style="@style/Widget.Attendance.GlassButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:text="@string/catch_up_label" app:icon="@drawable/ic_edit" />
                    <TextView android:id="@+id/biometricStatusText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:gravity="center" android:lineSpacingExtra="3dp"
                        android:textAppearance="@style/TextAppearance.Attendance.Label" />
                </LinearLayout>
            </com.example.myapplication.GlassCardView>

            <com.example.myapplication.GlassCardView android:id="@+id/monthCard"
                style="@style/Widget.Attendance.GlassCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" app:contentPadding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:clipChildren="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/previousMonthButton"
                            style="@style/Widget.Attendance.IconButton"
                            android:layout_width="48dp" android:layout_height="48dp" android:minHeight="48dp"
                            android:contentDescription="@string/previous_month" app:icon="@drawable/ic_chevron_left" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginHorizontal="8dp"
                            android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:gravity="center" android:text="@string/month_overview"
                                android:textAppearance="@style/TextAppearance.Attendance.Title" android:textSize="16sp" />
                            <TextView android:id="@+id/monthTitleText"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:gravity="center"
                                android:textAppearance="@style/TextAppearance.Attendance.Label" android:textSize="13sp" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/nextMonthButton"
                            style="@style/Widget.Attendance.IconButton"
                            android:layout_width="48dp" android:layout_height="48dp" android:minHeight="48dp"
                            android:contentDescription="@string/next_month" app:icon="@drawable/ic_chevron_right" />
                    </LinearLayout>
                    <TextView android:id="@+id/monthTotalText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:background="@drawable/bg_month_total"
                        android:paddingHorizontal="12dp" android:paddingVertical="9dp"
                        android:gravity="center" android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:orientation="horizontal"
                        android:baselineAligned="false" android:gravity="center_vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginEnd="12dp"
                            android:hint="@string/hourly_wage_compact" app:suffixText="đ"
                            app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/hourlyWageInput"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:maxLines="1" android:imeOptions="actionDone"
                                android:textSize="16sp" android:paddingHorizontal="12dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1.15" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/salary_estimate"
                                android:textAppearance="@style/TextAppearance.Attendance.Label" />
                            <TextView android:id="@+id/monthlySalaryText"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp" android:textSize="22sp"
                                android:fontFamily="sans-serif-medium" android:letterSpacing="-0.03"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:background="@drawable/bg_summary_row"
                        android:paddingHorizontal="6dp" android:paddingBottom="8dp"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <com.google.android.material.button.MaterialButton android:id="@+id/parkingButton"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="match_parent" android:layout_height="48dp"
                                android:minWidth="0dp" android:paddingHorizontal="8dp" android:gravity="start|center_vertical"
                                android:text="@string/parking_label" />
                            <TextView android:id="@+id/parkingFeeText"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:paddingHorizontal="8dp"
                                android:textAppearance="@style/TextAppearance.Attendance.Label" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/parkingMinusButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp"
                            android:padding="0dp" android:text="−" android:textSize="22sp"
                            android:contentDescription="@string/parking_remove" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/parkingAddButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp"
                            android:padding="0dp" android:text="+" android:textSize="22sp"
                            android:contentDescription="@string/parking_add" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/viewCalendarButton"
                        style="@style/Widget.Attendance.GlassButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:layout_marginTop="10dp" android:text="@string/view_attendance_calendar" app:icon="@drawable/ic_calendar" />
                </LinearLayout>
            </com.example.myapplication.GlassCardView>

            <com.example.myapplication.GlassCardView android:id="@+id/summaryFrame"
                style="@style/Widget.Attendance.GlassCard"
                android:layout_width="match_parent" android:layout_height="640dp" android:layout_marginTop="20dp"
                app:contentPadding="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/summaryHeader"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="20dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/daily_details" android:textAppearance="@style/TextAppearance.Attendance.Title" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="@string/daily_details_hint"
                            android:textAppearance="@style/TextAppearance.Attendance.Label" />
                    </LinearLayout>
                    <androidx.core.widget.NestedScrollView android:id="@+id/daySummaryScroll"
                        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingBottom="12dp"
                        android:fadingEdgeLength="16dp" android:requiresFadingEdge="vertical" android:scrollbars="none">
                        <LinearLayout android:id="@+id/monthlySummaryContainer"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </com.example.myapplication.GlassCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
