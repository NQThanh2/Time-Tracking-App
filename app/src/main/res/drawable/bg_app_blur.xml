<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="@color/attendance_background_top"
                android:centerColor="@color/attendance_background_center" android:endColor="@color/attendance_background_bottom" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="0.05" android:centerY="0.1"
                android:gradientRadius="330dp" android:startColor="@color/attendance_glow_teal"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:centerX="1" android:centerY="0.65"
                android:gradientRadius="350dp" android:startColor="@color/attendance_glow_blue"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
